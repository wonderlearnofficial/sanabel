# Sanabel Client Environment Configuration Template
# Do NOT place production secrets here.

# Shared Backend API base URL
VITE_API_BASE_URL=

# Standalone Admin Web Console URL (used by Admin login redirect screen)
VITE_ADMIN_APP_URL=

# Web Push VAPID Public Key
VITE_VAPID_PUBLIC_KEY=

# Tutorial V2 rollout (see docs/TUTORIAL_V2_PHASE1_IMPLEMENTATION.md)
# Experiences the V2 engine is enabled for: "on", "off", or a comma-separated
# list (solo,school-student,teacher,parent,school-admin,super-admin).
VITE_TUTORIAL_V2=

# Instant Tutorial V2 became available to Students, ISO-8601 UTC, e.g.
# 2026-09-08T00:00:00Z. Accounts created before it never receive automatic
# first-time onboarding. Leave blank until rollout: blank withholds age-gated
# guides, which is the safe direction.
VITE_TUTORIAL_V2_STUDENT_ROLLOUT_AT=

# Same idea, per audience. Adults are onboarded on their own date, so the
# Student instant is never reused for a Teacher or a Parent. Blank withholds
# automatic first-time onboarding for that audience.
VITE_TUTORIAL_V2_TEACHER_ROLLOUT_AT=
VITE_TUTORIAL_V2_PARENT_ROLLOUT_AT=
